<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Klip</string>
    <key>CFBundleDisplayName</key>
    <string>Klip</string>
    <key>CFBundleIdentifier</key>
    <string>com.yourcompany.klip</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>Klip</string>
     <key>CFBundleIconFile</key>
     <string>Klip</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- This is THE key that turns Klip into a background "agent" app:
         no Dock icon, no menu bar item, no app switcher entry. -->
    <key>LSUIElement</key>
    <true/>

    <!-- Shown once in the Accessibility permission prompt, required so the
         app can simulate the Cmd+V keystroke to auto-paste. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Klip needs to simulate keystrokes to automatically paste clipboard items into the active app.</string>
</dict>
</plist>
